<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:iconifiedByDefault="false"
            app:queryHint="Search places..." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNearMeMain"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/primary"
            android:drawablePadding="8dp"
            android:text="Near Me"
            android:textColor="@color/white"
            app:cornerRadius="20dp"
            app:icon="@android:drawable/ic_menu_mylocation"
            app:iconGravity="textStart" />

        <!-- Category Filter Buttons -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAllCategories"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/primary"
                    android:paddingHorizontal="16dp"
                    android:text="All"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:cornerRadius="20dp"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNature"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/white"
                    android:paddingHorizontal="16dp"
                    android:text="Nature"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    app:cornerRadius="20dp"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHistoricalSite"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/white"
                    android:paddingHorizontal="16dp"
                    android:text="Historical"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    app:cornerRadius="20dp"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModernArchitecture"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/white"
                    android:paddingHorizontal="16dp"
                    android:text="Modern"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    app:cornerRadius="20dp"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCulturalSite"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/white"
                    android:paddingHorizontal="16dp"
                    android:text="Cultural"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    app:cornerRadius="20dp"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNearMe"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/white"
                    android:drawablePadding="4dp"
                    android:paddingHorizontal="16dp"
                    android:text="Near Me"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    app:cornerRadius="20dp"
                    app:icon="@android:drawable/ic_menu_mylocation"
                    app:iconGravity="textStart" />

            </LinearLayout>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewPlaces"
            android:layout_width="match_parent"
            android:layout_height="446dp"
            android:clipToPadding="false"
            android:padding="8dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddPlace"
            android:layout_width="107dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="Add new place"
            app:srcCompat="@android:drawable/ic_input_add" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
